// Cloudflare config for the BillZap landing page. Deployed by
// .github/workflows/landing-page.yml; see worker.js for the routing.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "billzap",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  // node:crypto and Buffer for functions/lib/auth.js, and process.env
  // populated from the Worker's secrets, which is what the handlers read.
  "compatibility_flags": ["nodejs_compat"],

  // The deploy creates both hostnames on the billzap.app zone, with
  // their DNS records and certificates. worker.js 301s www to the apex.
  "routes": [
    { "pattern": "billzap.app", "custom_domain": true },
    { "pattern": "www.billzap.app", "custom_domain": true }
  ],
  "workers_dev": true,

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Fonts and images skip the Worker: they are most of the requests
    // and need nothing but the headers in _headers.
    "run_worker_first": ["/*", "!/assets/*"]
  },

  "observability": { "enabled": true }

  // Secrets (set by the deploy workflow, never committed):
  //   DATABASE_URL, ADMIN_PATH, ADMIN_PASSWORD, SESSION_SECRET
  //   RESEND_API_KEY, RESEND_FROM (optional: the /try email codes)
}
